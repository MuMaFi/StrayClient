{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stray Client",
  "version": "1.2.0",
  "identifier": "cc.straysmp.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stray Client",
        "width": 1180,
        "height": 740,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#1A1B24",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://cdn.modrinth.com https://media.forgecdn.net https://mc-heads.net; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "category": "Game",
    "shortDescription": "The official StraySMP client",
    "longDescription": "The official StraySMP client by StrayZii: a fast, lightweight Minecraft client with Sodium and FerriteCore preinstalled and Modrinth + CurseForge mod support.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English", "Russian"], "displayLanguageSelector": true }
    }
  }
}
